<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edge AI Benchmark"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Academic Research Testbed for On-Device Inference"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Hardware Telemetry Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE TELEMETRY"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDeviceModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device: Loading..."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvChipset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chipset / CPU: Loading..."
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRamAndroid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM / OS: Loading..."
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Benchmark Configuration Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BENCHMARK CONFIGURATION"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Model Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model Architecture:"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerModel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <!-- Precision Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precision Format:"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerPrecision"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <!-- CPU Threads & Iterations -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CPU Threads:"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spinnerThreads"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:backgroundTint="#FFFFFF" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Measured Iterations:"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spinnerRuns"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:backgroundTint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnRunBenchmark"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Run Selected Benchmark"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnRunAll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Run Full Matrix (15 Models)"
            android:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExportResults"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Export CSV / JSON Results"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:visibility="gone"
            android:progressTint="#38BDF8"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textColor="#4ADE80"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Results Metrics Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPERIMENTAL MEASUREMENTS"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvLatencySummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Latency: Median: -- ms | Mean: -- ms | P90: -- ms"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvMemorySummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sampled PSS: Baseline: -- MB | Peak: -- MB | Delta: -- MB"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvAccuracySummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accuracy: Top-1: --% (-- / -- correct)"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvTheoreticalSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theoretical: FLOPs: -- | Params: -- | Size: -- MB"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Detailed Execution Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXECUTION LOG"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvExecutionLog"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#090D16"
            android:padding="8dp"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:text="Initialized Edge AI Benchmark runtime.\nWaiting for user action.\n" />

    </LinearLayout>
</ScrollView>
